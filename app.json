{
  "expo": {
    "name": "nexart",
    "slug": "nexart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexart",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.nexart.app",
      "associatedDomains": [
        "applinks:nexart.app"
      ]
    },
    "android": {
      "package": "fr.nexart.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nexart.app",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "nexart.app",
              "pathPrefix": "/creator"
            },
            {
              "scheme": "https",
              "host": "nexart.app",
              "pathPrefix": "/discover"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "69b28ef6-b967-4914-ac62-6215b62e8fe6"
      }
    },
    "owner": "kaban13",
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/69b28ef6-b967-4914-ac62-6215b62e8fe6"
    }
  }
}